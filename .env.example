# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# The publishable key (sb_publishable_...) is meant to be public: it ships to
# the browser, and your data is protected by the row-level security rules in
# supabase/schema.sql. NEVER put the secret key (sb_secret_...) here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
